/* 已绑定 */
.bound-card {
  background: var(--cm-gradient);
  border-radius: 32rpx;
  padding: 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx -8rpx var(--cm-primary);
}
.bd-avatars {
  display: flex;
  align-items: center;
}
.bd-av {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cm-primary);
}
.bd-heart {
  display: flex;
  align-items: center;
  color: #ffffff;
  margin: 0 24rpx;
  animation: beat 1.2s ease-in-out infinite;
}
.bd-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 28rpx;
}
.bd-days {
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  margin-top: 10rpx;
}
.bd-partner {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 20rpx;
}
.unbind {
  margin-top: 60rpx;
}
@keyframes beat {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.18);
  }
}

/* 未绑定 */
.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cm-primary);
  margin-top: 40rpx;
  animation: float 2.4s ease-in-out infinite;
}
.hero-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 20rpx;
}
.hero-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--cm-text-2);
  margin-top: 12rpx;
}
.mt32 {
  margin-top: 48rpx;
}
.mt {
  margin-top: 24rpx;
}
.blk-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.code {
  text-align: center;
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: var(--cm-primary);
  padding: 24rpx 0 8rpx;
}
.code-expire {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  color: var(--cm-text-3);
}
.code-expire-ic {
  display: flex;
  align-items: center;
  margin-right: 6rpx;
}
.code-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 28rpx;
}
.invite-empty {
  padding: 12rpx 0;
}
.code-input-row {
  margin-bottom: 24rpx;
}
.code-input {
  background: var(--cm-bg);
  border-radius: 24rpx;
  height: 110rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 14rpx;
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
