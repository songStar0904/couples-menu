.form-hint {
  font-size: 22rpx;
  color: var(--cm-text-3);
  margin-left: 8rpx;
}
.img-row {
  display: flex;
}
.img-box {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.img-preview {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 0 0 0 24rpx;
}
.img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  background: var(--cm-bg);
  border: 2rpx dashed var(--cm-text-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--cm-text-2);
  transition: transform 0.15s;
}
.img-add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.picker-arrow {
  color: var(--cm-text-3);
  font-size: 36rpx;
}
.cat-add {
  font-size: 24rpx;
  color: var(--cm-primary);
  margin-top: 14rpx;
  padding: 4rpx 8rpx;
}
.price-hint {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: var(--cm-text-2);
  display: flex;
  align-items: center;
}
.price-hint-ic {
  display: flex;
  align-items: center;
  margin-right: 6rpx;
  color: var(--cm-primary);
}
.switch-label {
  margin-left: 18rpx;
  font-size: 26rpx;
  color: var(--cm-text-2);
}
.save-btn {
  margin-top: 32rpx;
}
.del-btn {
  margin-top: 20rpx;
}
