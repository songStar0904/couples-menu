.mt {
  margin-top: 24rpx;
}
.status-card {
  background: var(--cm-gradient);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx -8rpx var(--cm-primary);
}
.status-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  line-height: 1.2;
}
.status-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 12rpx;
}
.status-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}
.d-media {
  width: 116rpx;
  height: 116rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--cm-primary-soft);
}
.d-img {
  width: 100%;
  height: 100%;
}
.d-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cm-primary);
}
.d-main {
  margin: 0 20rpx;
}
.d-name {
  font-size: 32rpx;
  font-weight: 600;
}
.d-row {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}
.d-row-ic {
  display: flex;
  align-items: center;
  margin-right: 6rpx;
}
.tl-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.tl-emoji {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--cm-primary-soft);
  color: var(--cm-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.tl-text {
  font-size: 27rpx;
}
.tl-time {
  font-size: 22rpx;
  color: var(--cm-text-3);
}
.review-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.review-title-ic {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
  color: var(--cm-primary);
}
.stars {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.star {
  display: flex;
  align-items: center;
  color: var(--cm-primary);
  font-size: 40rpx;
  opacity: 0.18;
  filter: grayscale(1);
  transition: transform 0.15s;
}
.star.on {
  opacity: 1;
  filter: none;
  transform: scale(1.06);
}
.star.big {
  font-size: 52rpx;
}
.review-msg {
  font-size: 27rpx;
  color: var(--cm-text-2);
  line-height: 1.6;
}
.review-submit {
  margin-top: 24rpx;
}
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.da-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s;
}
.da-btn.primary {
  background: var(--cm-gradient);
  color: var(--cm-on-primary);
}
.da-btn.ghost {
  border: 2rpx solid var(--cm-line);
  color: var(--cm-text-2);
}
