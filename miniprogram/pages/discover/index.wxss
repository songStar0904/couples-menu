.search-box {
  display: flex;
  align-items: center;
  background: var(--cm-card);
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  box-shadow: var(--cm-shadow);
}
.search-icon {
  display: flex;
  align-items: center;
  color: var(--cm-text-3);
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
/* 响应式网格：窄屏两列，宽屏三列；用 margin 做间距（flex gap 在部分基础库不生效） */
.tpl-grid {
  display: flex;
  flex-wrap: wrap;
}
.tpl-cell {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}
.tpl-cell:nth-child(2n + 1) {
  margin-right: 24rpx;
}
@media (min-width: 640px) {
  .tpl-cell {
    width: calc(33.333% - 16rpx);
  }
  .tpl-cell:nth-child(3n + 1),
  .tpl-cell:nth-child(3n + 2) {
    margin-right: 24rpx;
  }
  .tpl-cell:nth-child(3n) {
    margin-right: 0;
  }
}
.insp {
  padding: 12rpx 28rpx;
}
.insp-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--cm-line);
}
.insp-item:last-child {
  border-bottom: none;
}
.insp-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--cm-primary-soft);
  color: var(--cm-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.insp-title {
  font-size: 28rpx;
  font-weight: 600;
}
.insp-desc {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 4rpx;
}
.submit-entry {
  margin-top: 36rpx;
  background: var(--cm-primary-soft);
  border-radius: 28rpx;
  padding: 30rpx;
  text-align: center;
  color: var(--cm-primary);
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.15s;
}
.submit-entry-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-entry-ic {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}
.submit-entry-sub {
  display: block;
  font-size: 22rpx;
  color: var(--cm-text-2);
  font-weight: 400;
  margin-top: 8rpx;
}
