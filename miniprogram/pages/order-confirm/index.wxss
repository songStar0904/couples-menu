.mt {
  margin-top: 24rpx;
}
.oc-media-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--cm-primary-soft);
}
.dish-img {
  width: 100%;
  height: 100%;
}
.dish-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cm-primary);
}
.date-ic {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
  color: var(--cm-text-2);
}
.dish-main {
  margin: 0 20rpx;
}
.dish-name {
  font-size: 34rpx;
  font-weight: 600;
}
.dish-cat {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 6rpx;
}
.dish-desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--cm-line);
  font-size: 26rpx;
  color: var(--cm-text-2);
  line-height: 1.6;
}
.picker-arrow {
  color: var(--cm-text-3);
  font-size: 36rpx;
}
.pay-title {
  font-size: 30rpx;
  font-weight: 600;
}
.pay-sub {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 6rpx;
}
.submit {
  margin-top: 36rpx;
}
.pay-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--cm-text-3);
  margin-top: 16rpx;
}
