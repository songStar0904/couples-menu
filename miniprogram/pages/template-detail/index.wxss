.cover {
  height: 280rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}
.head {
  padding: 28rpx 8rpx 4rpx;
}
.head-title {
  font-size: 40rpx;
  font-weight: 700;
}
.head-sub {
  font-size: 26rpx;
  color: var(--cm-text-2);
  margin-top: 10rpx;
  line-height: 1.6;
}
.head-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.head-tag {
  font-size: 22rpx;
  color: var(--cm-primary);
  background: var(--cm-primary-soft);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.mt {
  margin-top: 24rpx;
}
.list-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--cm-line);
}
.item:last-child {
  border-bottom: none;
}
.item-emoji {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: var(--cm-primary-soft);
  color: var(--cm-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.item-main {
  min-width: 0;
}
.item-name {
  font-size: 29rpx;
  font-weight: 600;
}
.item-cat {
  display: inline-block;
  font-size: 20rpx;
  color: var(--cm-text-2);
  background: var(--cm-bg);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-top: 6rpx;
}
.item-desc {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 6rpx;
  line-height: 1.5;
}
.item-price {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--cm-primary);
  font-weight: 600;
  flex-shrink: 0;
}
.item-price-ic {
  display: flex;
  align-items: center;
  margin-right: 4rpx;
}
.import-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.import-row-icon {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}
.import-btn {
  margin-top: 36rpx;
}
