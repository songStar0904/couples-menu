.menu-head {
  padding: 16rpx 32rpx 20rpx;
}

/* 休息横幅 */
.closed-banner {
  margin: 0 32rpx 20rpx;
  background: #fff7ec;
  color: #b26a2e;
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}
.cb-ic {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}

/* ===== 双栏点单布局 ===== */
.pm {
  display: flex;
  height: calc(100vh - 120rpx - 140rpx - env(safe-area-inset-bottom));
  padding: 0 32rpx;
  box-sizing: border-box;
  gap: 20rpx;
}
.pm-nav {
  width: 176rpx;
  flex-shrink: 0;
  background: var(--cm-card);
  border-radius: 24rpx;
  height: 100%;
}
.pm-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 8rpx;
  color: var(--cm-text-2);
  font-size: 24rpx;
  position: relative;
}
.pm-nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.pm-nav-item.on {
  color: var(--cm-primary);
  font-weight: 600;
}
.pm-nav-item.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26rpx;
  bottom: 26rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: var(--cm-gradient);
}
.pm-list {
  flex: 1;
  height: 100%;
}
.pm-group {
  margin-bottom: 32rpx;
}
.pm-cat-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
}
.pm-cat-ic {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
  color: var(--cm-primary);
}
.pm-cat-count {
  font-size: 22rpx;
  color: var(--cm-text-3);
  font-weight: 400;
  margin-left: 10rpx;
}
.pm-group dish-card {
  display: block;
  margin-bottom: 20rpx;
}

/* ===== 我的菜单 ===== */
.mine-head {
  padding: 0 32rpx;
}
.mine-stats {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 36rpx;
  background: var(--cm-primary-soft);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s;
}
.mine-stats-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--cm-primary);
  line-height: 1.2;
}
.mine-stats-label {
  font-size: 22rpx;
  color: var(--cm-text-2);
  margin-top: 4rpx;
}
.mine-closed {
  margin-bottom: 20rpx;
}
.mine-closed-title {
  font-size: 30rpx;
  font-weight: 600;
}
.mine-closed-sub {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 4rpx;
}
.mine-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}
.mine-cat-btn {
  font-size: 24rpx;
  color: var(--cm-text-2);
  padding: 10rpx 20rpx;
  transition: opacity 0.15s;
  display: flex;
  align-items: center;
}
.mc-btn-ic {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}
.mc-ic {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  color: #b26a2e;
}
.mine-add {
  margin-top: 32rpx;
  text-align: center;
  color: var(--cm-primary);
  font-size: 28rpx;
  font-weight: 600;
  padding: 26rpx;
  border: 2rpx dashed var(--cm-primary);
  border-radius: 28rpx;
  opacity: 0.8;
}

/* ===== 分类管理弹层 ===== */
.cat-mask {
  position: fixed;
  inset: 0;
  background: var(--cm-mask);
  z-index: 1500;
  display: flex;
  align-items: flex-end;
  animation: fade 0.2s ease;
}
.cat-panel {
  width: 100%;
  background: var(--cm-card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 36rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
  animation: slide-up 0.24s ease;
}
.cat-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-title-ic {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
  color: var(--cm-primary);
}
.cat-list {
  max-height: 50vh;
}
.cat-item {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--cm-line);
  font-size: 30rpx;
}
.cat-item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--cm-primary-soft);
  color: var(--cm-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.cat-op {
  color: var(--cm-primary);
  font-size: 26rpx;
  padding: 8rpx 18rpx;
}
.cat-op.del {
  color: var(--cm-danger);
}
.cat-tip {
  text-align: center;
  color: var(--cm-text-3);
  font-size: 22rpx;
  margin-top: 24rpx;
}
@keyframes fade {
  from {
    opacity: 0;
  }
}
@keyframes slide-up {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
}
