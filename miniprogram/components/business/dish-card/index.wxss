.dc {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--cm-card);
  border-radius: 28rpx;
  box-shadow: var(--cm-shadow);
  transition: transform 0.15s, opacity 0.15s;
}
.dc-press {
  transform: scale(0.98);
  opacity: 0.88;
}
.dc-media {
  width: 116rpx;
  height: 116rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--cm-primary-soft);
}
.dc-img {
  width: 100%;
  height: 100%;
}
.dc-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cm-primary);
  font-size: 56rpx;
}
.dc-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.dc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cm-text);
}
.dc-desc {
  font-size: 24rpx;
  color: var(--cm-text-2);
  margin-top: 6rpx;
}
.dc-meta {
  margin-top: 10rpx;
}
.dc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}
.dc-btn {
  background: var(--cm-gradient);
  color: var(--cm-on-primary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx -6rpx var(--cm-primary);
}
