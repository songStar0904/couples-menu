.sk {
  width: 100%;
}
.shimmer {
  background: linear-gradient(90deg, #f0eef2 25%, #faf9fb 40%, #f0eef2 60%);
  background-size: 400% 100%;
  animation: shimmer 1.3s ease infinite;
  border-radius: 12rpx;
}
@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}
.sk-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.sk-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.sk-line {
  height: 28rpx;
  margin: 12rpx 0;
}
.flex1 {
  flex: 1;
  min-width: 0;
}
.w90 { width: 90%; }
.w80 { width: 80%; }
.w70 { width: 70%; }
.w60 { width: 60%; }
.w50 { width: 50%; }
.w40 { width: 40%; }
.sk-card {
  background: var(--cm-card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-media {
  height: 240rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.sk-hero {
  height: 320rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
}
