.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--cm-danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.dot {
  min-width: 16rpx;
  width: 16rpx;
  height: 16rpx;
  padding: 0;
}
