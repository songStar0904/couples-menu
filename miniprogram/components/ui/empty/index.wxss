.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.empty-badge {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cm-primary-soft);
  color: var(--cm-primary);
  animation: float 2.4s ease-in-out infinite;
}
.empty-text {
  font-size: 30rpx;
  color: var(--cm-text);
  font-weight: 600;
  margin-top: 28rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: var(--cm-text-2);
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.6;
}
.empty-action {
  margin-top: 36rpx;
  min-height: 0;
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}
