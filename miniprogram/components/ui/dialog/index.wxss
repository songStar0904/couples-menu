.dlg-mask {
  position: fixed;
  inset: 0;
  background: var(--cm-mask);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: fade 0.2s ease;
}
.dlg {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 32rpx;
  box-sizing: border-box;
  animation: pop 0.22s cubic-bezier(0.34, 1.4, 0.64, 1);
}
.dlg-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  color: var(--cm-text);
}
.dlg-content {
  font-size: 28rpx;
  color: var(--cm-text-2);
  line-height: 1.6;
  text-align: center;
  margin-top: 20rpx;
}
.dlg-btns {
  display: flex;
  margin-top: 40rpx;
}
.dlg-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s, opacity 0.15s;
}
.dlg-press {
  transform: scale(0.96);
  opacity: 0.85;
}
.cancel {
  background: var(--cm-bg);
  color: var(--cm-text-2);
  margin-right: 20rpx;
}
.confirm {
  background: var(--cm-gradient);
  color: var(--cm-on-primary);
}
@keyframes fade {
  from {
    opacity: 0;
  }
}
@keyframes pop {
  from {
    opacity: 0;
    transform: scale(0.86);
  }
}
